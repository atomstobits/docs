  "projectType": "cli-tool",
  "projectName": "PAW — Physical Agent Worker",
  "projectDescription": "PAW is a zero-dependency CLI tool that gives AI agents a visible, animated cursor in a real browser via the Chrome DevTools Protocol, with human-in-the-loop shared control and a built-in audit log.",
