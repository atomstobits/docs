  "keyFeatures": [
    "Visible Bézier-curve animated cursor for every click — human can follow AI actions in real time",
    "Human-in-the-loop shared control via Alt+drag to redirect AI mid-task",
    "Append-only audit log at ~/.pawprint with optional HTTP PUT to any remote byte server",
    "Zero runtime dependencies — uses native Node.js WebSocket, no Playwright, Puppeteer, or MCP",
    "Raw Chrome DevTools Protocol (CDP) — connects to any existing Chromium-family browser",
    "Element indexing with paw snapshot for token-efficient AI prompting",
    "Batch mode (paw batch) to run many verbs in a single CDP session",
    "Configurable speed presets: fast (~280ms), normal (~1.4s), slow (~3.5s)",
    "11 built-in cookie consent manager (CMP) patterns via paw dismiss-cookies",
    "Page logging (console, fetch, XHR, errors) via paw log"
  ],
  "publicApiSurface": [
    "paw start [brave|chrome|edge] [--url U] [--port P]",
    "paw connect [url-substring]",
    "paw close",
    "paw snapshot",
    "paw visible",
    "paw show <text|sel>",
    "paw nearby [--radius N] [--limit N]",
    "paw text <n|sel>",
    "paw html [sel]",
    "paw screenshot [path]",
    "paw position",
    "paw box <n|sel>",
    "paw click <n|sel> [--right|--middle]",
    "paw dblclick <n|sel>",
    "paw rightclick <n|sel>",
    "paw hover <n|sel>",
    "paw type <n|sel> <text|@file|->",
    "paw keypress <key>",
    "paw drag <src> <tgt>",
    "paw scroll <up|down|left|right> [px]",
    "paw move <x> <y>",
    "paw moveby <dx> <dy>",
    "paw press [--right|--middle]",
    "paw release",
    "paw goto <url>",
    "paw eval <expr|@file.js|->",
    "paw wait <n|sel>",
    "paw wait-idle [stableMs]",
    "paw log [--since 5s] [--type T] [--status '>=N']",
    "paw dismiss-cookies [--reject|--list]",
    "paw batch [@file|-]",
    "paw stay",
    "paw unstay",
    "paw help"
  ]
}
